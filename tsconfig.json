{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "paths": {
      "@nethernet-proxy/emitter": ["./packages/emitter/src/index.ts"],
      "@nethernet-proxy/relay": ["./packages/relay/src/index.ts"]
    },
    "strict": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["main.ts", "packages/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "**/node_modules/**", "**/dist/**"]
}
