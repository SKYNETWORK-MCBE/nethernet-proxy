{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["main.ts", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
