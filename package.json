{
  "name": "nethernet-proxy",
  "version": "0.0.0",
  "description": "NetherNet transport proxy with synchronous Bedrock packet hooks",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "files": [
    "dist",
    "README.md",
    "docs/implementation.md",
    "docs/validation.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "nub main.ts",
    "build": "vp pack",
