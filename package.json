    "@serenityjs/protocol": "^0.8.21",
    "nethernet": "1.1.2",
    "nethernet-gateway": "^0.2.0",
    "prismarine-auth": "3.1.1",
    "snappyjs": "0.7.0"
  },
  "devDependencies": {
    "@nubjs/nub": "^0.9.5",
    "@types/node": "^24.0.0",
    "@types/snappyjs": "^0.7.1",
    "jose": "^6.2.12",
    "typescript": "^6.0.3",
    "vite-plus": "^1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
